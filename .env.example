# ── App ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Public URL users open (used in email links). No trailing slash.
APP_URL=https://memento.example.com
# Behind a reverse proxy (Pangolin, Caddy, ...): the number of proxies in front of the app,
# or the proxy's IP/CIDR (e.g. 10.0.0.0/8). "true" means 1. Use false when nothing is in front.
TRUST_PROXY=1

# ── Postgres (external) ──────────────────────────────
DATABASE_URL=postgres://memento:password@db.example.lan:5432/memento
# Connection pool size (optional)
DB_POOL_MAX=10

# ── MinIO / S3 (external) ────────────────────────────
S3_ENDPOINT=http://minio.example.lan:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=memento
S3_FORCE_PATH_STYLE=true
# URL the browser uses for presigned uploads and image GETs.
# Must be reachable from users' devices (e.g. MinIO's S3 port exposed through the reverse proxy).
# Leave empty to use S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=

# ── Secrets ──────────────────────────────────────────
# Signs cookies. At least 32 chars:  openssl rand -base64 48
SESSION_SECRET=
# Encrypts the AI API key at rest. 32 bytes base64:  openssl rand -base64 32
ENCRYPTION_KEY=

# ── Super-admin ──────────────────────────────────────
ADMIN_EMAIL=admin@example.com

# ── SMTP (optional) ──────────────────────────────────
# Without SMTP_HOST, invite and magic-link emails are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Memento <memento@example.com>

# AI caption settings (endpoint, key, model, prompts) are NOT env vars.
# Set them in the app: Editor's Desk → AI captions.
