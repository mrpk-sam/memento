{
  "name": "memento",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/mrpk-sam/memento#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrpk-sam/memento.git"
  },
  "bugs": {
    "url": "https://github.com/mrpk-sam/memento/issues"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @memento/api --filter @memento/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "db:generate": "pnpm --filter @memento/api db:generate",
    "db:migrate": "pnpm --filter @memento/api db:migrate",
    "db:seed": "pnpm --filter @memento/api db:seed",
    "check:storage": "pnpm --filter @memento/api check:storage"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
